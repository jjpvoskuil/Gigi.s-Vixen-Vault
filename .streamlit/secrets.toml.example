# Copy these into Streamlit Cloud → your app → Settings → Secrets.
# Never commit real values to GitHub.

APP_PASSWORD = "pick-a-password-for-gigi"

ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_MODEL = "claude-sonnet-5-5"

[supabase]
url = "https://YOUR-PROJECT-ID.supabase.co"
key = "sb_secret_..."   # the SECRET key (or legacy service_role key), not the publishable/anon key
bucket = "vault"
